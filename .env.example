# Autotask API credentials (API-only user in Autotask: Admin > Resources/Users)
AUTOTASK_USERNAME=apiuser@example.com
AUTOTASK_SECRET=your-api-secret-here
AUTOTASK_INTEGRATION_CODE=your-integration-code-here

# Optional: pin the API zone base URL to skip auto-detection
# (e.g. https://webservices2.autotask.net/atservicesrest/)
# AUTOTASK_API_URL=

# Optional: read-only mode — skips registration of all write/destructive tools
# AUTOTASK_READ_ONLY=false

# Optional HTTP transport (default transport is stdio)
# AUTOTASK_TRANSPORT=http
# AUTOTASK_HTTP_TOKEN=use-a-random-token-at-least-16-chars
# AUTOTASK_HTTP_HOST=127.0.0.1
# PORT=3000
