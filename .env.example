# Autotask API credentials (API-only user in Autotask: Admin > Resources/Users)
# NOTE: the API User (API-only) security level grants full system administrator
# access to Autotask data over REST, and the credential never expires. Give this
# server its own dedicated API user on a custom security level scoped to what it
# actually needs, rather than reusing an existing integration's credential.
AUTOTASK_USERNAME=apiuser@example.com
AUTOTASK_SECRET=your-api-secret-here
AUTOTASK_INTEGRATION_CODE=your-integration-code-here

# Optional: pin the API zone base URL to skip auto-detection
# (e.g. https://webservices2.autotask.net/atservicesrest/)
# AUTOTASK_API_URL=

# Optional: read-only mode — skips registration of all write/destructive tools
# AUTOTASK_READ_ONLY=false

# Ticket status codes treated as "closed" by search-tickets openOnly
# AUTOTASK_CLOSED_STATUS_IDS=5,16

# --- HTTP transport (default transport is stdio) -----------------------------
# AUTOTASK_TRANSPORT=http
# AUTOTASK_HTTP_TOKEN=use-a-random-token-at-least-16-chars
# Bind host. Keep 127.0.0.1 locally; containers need 0.0.0.0 for the published
# port to be reachable.
# AUTOTASK_HTTP_HOST=127.0.0.1
# PORT=3000

# Comma-separated Host allowlist (DNS-rebinding protection). Unset trusts the
# proxy in front of the service.
# AUTOTASK_HTTP_ALLOWED_HOSTS=mcp.autotask.phoneware.cloud

# Comma-separated browser Origin allowlist. Unset denies ALL browser origins,
# which is correct for Claude Code and server-side connectors (they send no
# Origin header). Only set this for a genuine browser client.
# AUTOTASK_HTTP_ALLOWED_ORIGINS=https://example.com

# Requests per minute per client IP against /mcp. 0 disables.
# AUTOTASK_RATE_LIMIT=120
# AUTOTASK_MAX_SESSIONS=100
# AUTOTASK_SESSION_TTL_MS=1800000
# AUTOTASK_MAX_BODY_BYTES=4194304

# --- Autotask API budget governor --------------------------------------------
# Autotask allows 10,000 requests/hour per DATABASE across every integration,
# and 3 concurrent requests per object endpoint per tracking identifier.
# Exceeding the hourly budget suspends API access for the whole tenant, so the
# governor stops serving calls before that happens.
# AUTOTASK_THRESHOLD_STOP_PCT=90
# AUTOTASK_THRESHOLD_WARN_PCT=75
# AUTOTASK_MAX_CONCURRENT=3
